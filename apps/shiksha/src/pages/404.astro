---
import Layout from '../components/Layout.astro';
import type { Page } from '../lib/routes';
const page: Page = { type: 'offline', locale: 'en', path: '/404/', title: 'Page not found', description: 'Browse the study library or search for a chapter.', crumbs: [{ path: '/', label: 'Home' }, { path: '/404/', label: 'Page not found' }], index: false };
---
<Layout {page}><section class="wrap reading section-page"><h1>{page.title}</h1><p>{page.description}</p><a class="button" href="/search/">Search the library</a></section></Layout>
